{
  "name": "mcp-google-crux",
  "version": "0.1.0",
  "description": "MCP server for the Chrome UX Report (CrUX) API — real-user Core Web Vitals (LCP, INP, CLS, TTFB) and 40-week history for any origin or URL. For Claude, Cursor, Codex and other AI clients.",
  "mcpName": "io.github.A1-x-Tech/mcp-google-crux",
  "type": "module",
  "bin": {
    "mcp-google-crux": "dist/index.js"
  },
  "files": [
    "dist",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crux",
    "chrome-ux-report",
    "core-web-vitals",
    "web-vitals",
    "web-performance",
    "lcp",
    "inp",
    "cls",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "author": "gistrec <gistrec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1-x-Tech/mcp-google-crux.git"
  },
  "homepage": "https://github.com/A1-x-Tech/mcp-google-crux#readme",
  "bugs": {
    "url": "https://github.com/A1-x-Tech/mcp-google-crux/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
